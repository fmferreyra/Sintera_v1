SINTERA_VERSION=0.1.0

POSTGRES_DB=sintera
POSTGRES_USER=sintera
POSTGRES_PASSWORD=CHANGE_ME

REDMINE_DB_HOST=db
REDMINE_DB_PORT=5432
REDMINE_DB_DATABASE=sintera
REDMINE_DB_USERNAME=sintera
REDMINE_DB_PASSWORD=CHANGE_ME

SECRET_KEY_BASE=CHANGE_ME

# Acceso sin dominio: usar HTTP_PORT=3000 y HTTPS_PORT=3443.
# Con dominio, cambiar a HTTP_PORT=80 y HTTPS_PORT=443 para HTTPS automatico.
HTTP_PORT=3000
HTTPS_PORT=3443
DOMAIN_NAME=
LETSENCRYPT_EMAIL=admin@example.com

# SMTP opcional. Dejar SMTP_ADDRESS vacio para mantener las notificaciones por correo desactivadas.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
REDMINE_EMAIL_FROM=